# Optional: the app prompts for and saves one of these on first run if none is
# set, so you normally don't need this file. Still here in case you want to set
# things up non-interactively -- copy to .env, keep only the one provider you're
# using, and fill in your real key. .env is gitignored -- never commit the real
# one.
#
# THE APP READS THIS FILE ITSELF (genpipe/settings.py, called from
# genpipe/__main__.py before anything else), so `python -m genpipe` and
# ./start_agent.sh behave identically. Anything already exported in your shell
# wins over what is written here -- loading never overwrites.
#
# Whichever key you set, also set GENPIPE_LLM_SOURCE/GENPIPE_LLM_MODEL to
# match (the interactive prompt sets these for you automatically); otherwise
# the agent defaults to Anthropic regardless of which key is present.

export ANTHROPIC_API_KEY=sk-ant-...
# export OPENAI_API_KEY=sk-...
# export GEMINI_API_KEY=AIza...
# export GROQ_API_KEY=gsk_...

export GENPIPE_LLM_SOURCE=Anthropic
export GENPIPE_LLM_MODEL=claude-sonnet-5

# PATHS IN THIS FILE MUST BE ABSOLUTE. This file is read by the app itself, not
# by a shell (genpipe/settings.py), and that reader deliberately does no
# expansion of any kind -- no `~`, no `$VAR`. It is not being lax: an API key is
# an opaque string, and a parser that expands things inside values is a parser
# that can silently mangle one. So `~/scratch` written here stays four literal
# characters and creates a directory actually named `~`. Spell it out.
#
# Where the agent keeps its own files: the checkpoint database (which is what
# lets a run held at the gate be approved in a later session) and runs.jsonl.
# Defaults to $HOME/scratch, since that is writable and persistent on DRAC.
# /where prints the paths actually in use.
#
# NOT the directory your GenPipes output lands in. That one has no variable on
# purpose: it is whatever directory you were standing in when you launched
# start_agent.sh, because that is where GenPipes writes and where a run's job
# list is looked for afterwards. See the README's "The four locations".
# export GENPIPE_AGENT_WORKDIR=/home/YOUR_USERNAME/scratch

# ---------------------------------------------------------------------------
# READ BY start_agent.sh, NOT BY THE APP -- so these belong in your shell, not
# in this file. It sources .env one line before exec'ing python, which is after
# it has already made every decision below.
#
#   GENPIPE_PYTHON_MODULE   the Python module to load. Default python/3.12.4,
#                           which is Rorqual's 3.12 and the validated
#                           combination. An escape hatch, not a portability
#                           claim -- and only ever another 3.12: that is the
#                           version the suites and CI run on.
#   GENPIPE_VENV            where the virtual environment is built. Default
#                           $HOME/scratch/biomni-venv. ~/scratch is cluster-local
#                           on the Alliance, so the venv is built once per
#                           machine rather than once per account.
#   GENPIPE_SKIP_GENPIPES_CHECK
#                           launch even though `module load
#                           mugqic/genpipes/6.1.1` does not resolve. The check
#                           exists so a missing module tree costs an error at
#                           launch rather than a model call, a generated command
#                           and an approval.
#
# RAP_ID and JOB_MAIL are deliberately absent from this file entirely. They
# belong to GenPipes, they come from the environment your shell already exports,
# and this app reads them rather than owning them.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Dev mode. Normally set by ./start_agent.sh --fake [--fake-llm] rather than
# here; the env vars exist so a non-interactive launch can reach it too.
#
# GENPIPE_FAKE puts a stubbed GenPipes and Slurm at the front of PATH, so
# nothing touches a real cluster. GENPIPE_FAKE_LLM adds a scripted stand-in
# for the model, so nothing costs anything either. Either one makes the app
# say "dev mode" under the banner on every launch.
#
# GENPIPE_FAKE_STATE picks which canned cluster the stubs present:
#   happy | running | failed-oom | failed-missing-input | dying
# ---------------------------------------------------------------------------
# export GENPIPE_FAKE=1
# export GENPIPE_FAKE_LLM=1
# export GENPIPE_FAKE_STATE=failed-oom

# ---------------------------------------------------------------------------
# Colours. auto | light | dark, and it is the whole of the theme interface --
# there is no slash command, because this is a property of the terminal you are
# sitting at rather than a decision about a run.
#
#   dark / light   authoritative. Always wins, never second-guessed. Picks a
#                  palette whose colours were measured against that background
#                  (genpipe/theme.py has the contrast tables).
#   auto           best-effort: reads COLORFGBG if the terminal sets it, and
#                  otherwise falls through. Nothing is asked of the terminal,
#                  so this cannot hang over ssh, under tmux or in CI.
#   unset          the background-agnostic palette, which is what this shipped
#                  with. Safe everywhere, optimal nowhere -- set the variable.
#
# NO_COLOR=1 or TERM=dumb switch colour off entirely and beat all of the above.
# ---------------------------------------------------------------------------
# export GENPIPE_THEME=dark

# Where the settings file itself lives. Defaults to the .env beside the
# checkout, which is where the app writes it. Absolute, as above -- and this
# one is read before anything else, so a `~` here points the whole settings
# file at a path that does not exist.
# export GENPIPE_ENV_FILE=/home/YOUR_USERNAME/.config/genpipe.env
