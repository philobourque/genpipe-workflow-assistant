# Secrets. .env* rather than .env: a stray .env.bak or .env.local holds a real
# key just as surely as .env does, and the negation keeps the template tracked.
.env*
!.env.example

# Python
__pycache__/
*.pyc

# Editor
*.swp
*.swo
*.swn
*.swk
*.swl
.viminfo

# Runtime artifacts the agent itself creates
genpipe_checkpoints.sqlite
job_output/
runs.jsonl
biomni_data/
# The generation artifact: whatever a `genpipes ... -g` call wrote last.
cmd.sh

# venv
venv/
.venv/
biomni-venv/

