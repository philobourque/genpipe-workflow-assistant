# Secrets. .env* rather than .env: a stray .env.bak or .env.local holds a real
# key just as surely as .env does, and the negation keeps the template tracked.
.env*
!.env.example

# Python
__pycache__/
*.pyc

# Editor
*.swp
*.swo
*.swn
*.swk
*.swl
.viminfo

# Runtime artifacts the agent itself creates
genpipe_checkpoints.sqlite
job_output/
runs.jsonl
biomni_data/
# The generation artifact: whatever a `genpipes ... -g` call wrote last.
cmd.sh
*_cmd.sh
# GenPipes' own output, for when the app was launched from inside the repo. It
# should not be -- launch it from the directory the run belongs in -- but it
# happens, and one CIT run leaves a gigabyte of trimmed reads here. Ignored
# rather than tolerated: `git add -A` in a directory like that is one keystroke.
trim/
alignment/
kallisto/
metrics/
report/
tracks/
variants/
methylation/
peak_call/
raw_reads/
pairedVariants/
SVariants/
deliverables/
*.config.trace.ini
# Scratch inputs and generated scripts from walking testcases/SCENARIOS.md.
design.tsv
*_cit.sh
*_cit/
# What the last cluster test case recorded. Useful locally, not shared history.
testcases/last-run-*.json

# venv
venv/
.venv/
biomni-venv/

