# Secrets. .env* rather than .env: a stray .env.bak or .env.local holds a real
# key just as surely as .env does, and the negation keeps the template tracked.
.env*
!.env.example

# Python
__pycache__/
*.pyc

# Editor
*.swp
*.swo
*.swn
*.swk
*.swl
.viminfo

# Runtime artifacts the agent itself creates
genpipe_checkpoints.sqlite
job_output/
runs.jsonl
biomni_data/
# The generation artifact: whatever a `genpipes ... -g` call wrote last.
cmd.sh
*_cmd.sh
# GenPipes' own output, for when the app was launched from inside the repo. It
# should not be -- launch it from the directory the run belongs in -- but it
# happens, and one CIT run leaves a gigabyte of trimmed reads here. Ignored
# rather than tolerated: `git add -A` in a directory like that is one keystroke.
trim/
alignment/
kallisto/
metrics/
report/
tracks/
variants/
methylation/
peak_call/
raw_reads/
pairedVariants/
SVariants/
deliverables/
*.config.trace.ini
# Scratch inputs and generated scripts from walking testcases/SCENARIOS.md.
design.tsv
*_cit*.sh
*_cit/
# The two generated scripts that carry no convention in their names, because a
# person typed them. There is no glob for "a pipeline wrote this": every one of
# them opens `#!/bin/bash` and runs to six figures of bytes, so they are named
# here rather than caught by a pattern loose enough to swallow start_agent.sh.
dnaseq_trail2.sh
# Overrides: what override.py writes ({name}.override.ini), and the hand-made
# ones alongside them.
*.override.ini
override_*.ini
override_*.ini.bak
# Transcripts and sacct dumps kept while testing against the real scheduler.
*.log
*_log.tsv
# What the last cluster test case recorded. Useful locally, not shared history.
testcases/last-run-*.json

# venv
venv/
.venv/
biomni-venv/

